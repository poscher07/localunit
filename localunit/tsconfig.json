{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "jsx": "react-jsx",
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "./.ts",
    "rootDir": "./src",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "skipDefaultLibCheck": true
  },
  "include": ["src", "App.js", "index.js"],
  "exclude": ["node_modules", ".expo"]
}